# Copia questo file in .env.local (sviluppo) o inserisci le variabili su Vercel
# (Project → Settings → Environment Variables). Non vanno mai su GitHub.

# Token Openapi (console.openapi.com → API Company → token con scope IT-search).
# Senza token l'app funziona in modalità dimostrativa.
OPENAPI_TOKEN=

# 1 = usa l'ambiente di prova di Openapi (test.company.openapi.com), senza costi reali
OPENAPI_SANDBOX=1

# Password che protegge stima e acquisto dei nominativi. Si inserisce nelle Impostazioni dell'app.
APP_PASSWORD=
