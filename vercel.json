{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/companies.ts": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
